# Cache Control Headers for Senara
# Works with Wasmer, Netlify, Cloudflare Pages, Vercel

# HTML pages - never cache aggressively (always revalidate)
/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

