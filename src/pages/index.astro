---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Senara - Stories That Change How You See the World"
  description="Free interactive stories that teach mental health, relationships, money, and life skills. Not a lecture. Not a textbook. A story you live through."
  canonical="https://senara.id/"
  pageName="home"
  schema={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Senara",
    "url": "https://senara.id/",
    "description": "Free interactive stories that teach mental health, relationships, money, and life skills.",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://senara.id/collection?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  })}
>
  <link rel="stylesheet" href="/style/story-cards.css" slot="styles" />

  <section class="hero-shell relative overflow-hidden">
    <div class="hero-blob hero-blob--one"></div>
    <div class="hero-blob hero-blob--two"></div>

    <div class="max-w-7xl mx-auto w-full relative z-10 px-4 py-20 md:py-28 lg:py-32">
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-sm font-semibold text-[#6366F1] tracking-widest uppercase mb-6" data-i18n="home.badge">
          Free &middot; Nonprofit &middot; No Sign-up
        </p>

        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-[#0F172A] leading-[1.1] tracking-tight mb-6" data-i18n-html="home.headline">
          You don't just read these stories.<br>
          <span class="text-[#4F46E5]">You live them.</span>
        </h1>

        <p class="text-lg md:text-xl text-[#64748B] leading-relaxed max-w-2xl mx-auto mb-10" data-i18n="home.subheadline">
          Interactive stories about mental health, relationships, money, and life — told through characters who feel real. Every choice you make teaches something you won't forget.
        </p>

        <div class="flex flex-col sm:flex-row gap-3 justify-center mb-12">
          <a href="/collection" class="btn-primary px-8 py-4 text-lg" data-umami-event="Home hero Start" data-i18n="home.ctaStart">
            Start a Story
          </a>
          <a href="#chapter-1" class="btn-secondary px-8 py-4 text-lg" data-i18n="home.ctaLearnMore">
            See How It Works
          </a>
        </div>

        <div class="flex items-center justify-center gap-6 text-sm text-[#94A3B8]">
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-[#F97316]" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <span data-i18n="home.rating">4.8 reader rating</span>
          </div>
          <div class="w-px h-4 bg-[#E2E8F0]"></div>
          <span data-i18n="home.readers">1,250+ readers</span>
          <div class="w-px h-4 bg-[#E2E8F0]"></div>
          <span data-i18n="home.free">100% free</span>
        </div>
      </div>
    </div>
  </section>

  <section class="vn-demo-section" id="demo">
    <div class="max-w-5xl mx-auto px-4">
      <div class="text-center mb-8">
        <p class="text-sm font-semibold text-[#4F46E5] tracking-widest uppercase mb-3" data-i18n="home.demoLabel">Try It Now</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#0F172A]" data-i18n="home.demoTitle">
          See what "interactive story" actually means.
        </h2>
      </div>

      <div class="vn-player" id="vnDemo">
        <div class="vn-screen" tabindex="0" role="button" aria-label="Story demo — click or press Enter to advance">
          <img class="vn-bg" id="vnBg" src="/monogatari/assets/scenes/1.jpg" alt="Story scene" loading="eager">
          <div class="vn-overlay"></div>

          <div class="vn-textbox" id="vnTextbox">
            <div class="vn-speaker" id="vnSpeaker">
              <span class="vn-speaker-name">Vani</span>
            </div>
            <p class="vn-dialog" id="vnDialog"></p>
            <span class="vn-continue" id="vnContinue"></span>
          </div>

          <div class="vn-choices" id="vnChoices"></div>
        </div>

        <div class="vn-footer">
          <span class="vn-story-tag" data-i18n="home.demoStoryTag">Mental Health Hero — Chapter 1</span>
          <a href="/story/?id=pahlawan-kesehatan-mental" class="vn-full-link" data-umami-event="Demo Play Full" data-i18n="home.demoPlayFull">
            Play Full Story
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="chapter-1" class="py-20 md:py-28 px-4 bg-white">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-14">
        <p class="text-sm font-semibold text-[#F97316] tracking-widest uppercase mb-3" data-i18n="home.problemLabel">The Problem</p>
        <h2 class="text-3xl md:text-4xl font-bold text-[#0F172A] leading-tight" data-i18n-html="home.problemTitle">
          The topics that matter most<br>are the hardest to learn.
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-6 mb-14">
        <div class="bg-[#F8FAFC] rounded-2xl p-6 border border-[#E2E8F0]">
          <div class="w-10 h-10 rounded-xl bg-red-50 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="font-bold text-[#0F172A] mb-2" data-i18n="home.problem1Title">Mental health is misunderstood</h3>
          <p class="text-sm text-[#64748B] leading-relaxed" data-i18n="home.problem1Desc">1 in 5 young people struggle with mental health, but most don't know where to start learning about it.</p>
        </div>

        <div class="bg-[#F8FAFC] rounded-2xl p-6 border border-[#E2E8F0]">
          <div class="w-10 h-10 rounded-xl bg-[#F8FAFC] flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-[#F97316]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <h3 class="font-bold text-[#0F172A] mb-2" data-i18n="home.problem2Title">Textbooks don't connect</h3>
          <p class="text-sm text-[#64748B] leading-relaxed" data-i18n="home.problem2Desc">Important topics are wrapped in boring formats. You read, you forget. Nothing sticks.</p>
        </div>

        <div class="bg-[#F8FAFC] rounded-2xl p-6 border border-[#E2E8F0]">
          <div class="w-10 h-10 rounded-xl bg-violet-50 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-violet-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="font-bold text-[#0F172A] mb-2" data-i18n="home.problem3Title">Free quality content is rare</h3>
          <p class="text-sm text-[#64748B] leading-relaxed" data-i18n="home.problem3Desc">Good educational content is locked behind paywalls. Free content is shallow or clickbait.</p>
        </div>
      </div>

      <div class="text-center">
        <p class="text-lg text-[#64748B] italic" data-i18n="home.problemBridge">
          What if learning about life felt like living through a story?
        </p>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-14">
        <p class="text-sm font-semibold text-[#4F46E5] tracking-widest uppercase mb-3" data-i18n="home.experienceLabel">The Experience</p>
        <h2 class="text-3xl md:text-4xl font-bold text-[#0F172A] leading-tight" data-i18n-html="home.experienceTitle">
          Meet the characters.<br>Make the choices. Learn by living.
        </h2>
      </div>

      <div class="featured-grid mb-12" id="featuredContainer"></div>

      <div class="text-center mt-8">
        <a href="/collection" class="btn-secondary inline-flex items-center gap-2 px-6 py-3" data-umami-event="Home see all stories">
          <span data-i18n="home.seeAll">See All Stories</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28 px-4 bg-white">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14">
        <p class="text-sm font-semibold text-[#F59E0B] tracking-widest uppercase mb-3" data-i18n="home.whatsNewLabel">What's New</p>
        <h2 class="text-3xl md:text-4xl font-bold text-[#0F172A] leading-tight" data-i18n="home.whatsNewTitle">
          Fresh from the studio.
        </h2>
      </div>
      <div class="whats-new-grid" id="whatsNewContainer"></div>
    </div>
  </section>

  <section id="chapter-3" class="py-20 md:py-28 px-4 bg-white">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14">
        <p class="text-sm font-semibold text-[#10B981] tracking-widest uppercase mb-3" data-i18n="home.howLabel">How It Works</p>
        <h2 class="text-3xl md:text-4xl font-bold text-[#0F172A]" data-i18n="home.howTitle">
          Three steps. Zero friction.
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-14 h-14 rounded-2xl bg-[#EEF2FF] flex items-center justify-center mx-auto mb-5">
            <svg class="w-6 h-6 text-[#4F46E5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"/></svg>
          </div>
          <div class="text-xs font-bold text-[#4F46E5] mb-2" data-i18n="home.step1Label">Step 1</div>
          <h3 class="text-lg font-bold text-[#0F172A] mb-2" data-i18n="home.step1Title">Pick a story</h3>
          <p class="text-sm text-[#64748B] leading-relaxed" data-i18n="home.step1Desc">Browse topics — mental health, money, relationships, and more. Each story is a different world.</p>
        </div>

        <div class="text-center">
          <div class="w-14 h-14 rounded-2xl bg-[#FFF7ED] flex items-center justify-center mx-auto mb-5">
            <svg class="w-6 h-6 text-[#F97316]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
          </div>
          <div class="text-xs font-bold text-[#F97316] mb-2" data-i18n="home.step2Label">Step 2</div>
          <h3 class="text-lg font-bold text-[#0F172A] mb-2" data-i18n="home.step2Title">Make choices</h3>
          <p class="text-sm text-[#64748B] leading-relaxed" data-i18n="home.step2Desc">You're not a spectator. You're in the story. Every decision leads somewhere different.</p>
        </div>

        <div class="text-center">
          <div class="w-14 h-14 rounded-2xl bg-[#ECFDF5] flex items-center justify-center mx-auto mb-5">
            <svg class="w-6 h-6 text-[#10B981]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
          </div>
          <div class="text-xs font-bold text-[#10B981] mb-2" data-i18n="home.step3Label">Step 3</div>
          <h3 class="text-lg font-bold text-[#0F172A] mb-2" data-i18n="home.step3Title">Learn something real</h3>
          <p class="text-sm text-[#64748B] leading-relaxed" data-i18n="home.step3Desc">The lesson isn't a bullet point. It's a feeling. Something you experienced, not memorized.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28 px-4 overflow-hidden">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-sm font-semibold text-[#EC4899] tracking-widest uppercase mb-3" data-i18n="home.topicsLabel">Topics</p>
        <h2 class="text-3xl md:text-4xl font-bold text-[#0F172A]" data-i18n="home.categoriesTitle">
          Stories about things that actually matter.
        </h2>
      </div>
      <div class="category-carousel" id="categoryCarousel"></div>
    </div>
  </section>

  <section class="py-20 md:py-28 px-4 bg-white">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14">
        <p class="text-sm font-semibold text-[#4F46E5] tracking-widest uppercase mb-3" data-i18n="home.whyLabel">Why It Works</p>
        <h2 class="text-3xl md:text-4xl font-bold text-[#0F172A] leading-tight" data-i18n-html="home.whyTitle">
          Reading is passive.<br>Stories are experiences.
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-8 mb-14">
        <div class="bg-[#F8FAFC] rounded-2xl p-8 border border-[#E2E8F0]">
          <h3 class="text-sm font-bold text-[#94A3B8] uppercase tracking-wider mb-6" data-i18n="home.traditionalLabel">Traditional Learning</h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-[#CBD5E1] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              <span class="text-[#64748B]" data-i18n="home.trad1">Read a textbook, forget in a week</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-[#CBD5E1] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              <span class="text-[#64748B]" data-i18n="home.trad2">One-way lectures, no participation</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-[#CBD5E1] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              <span class="text-[#64748B]" data-i18n="home.trad3">Abstract concepts, no real context</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-[#CBD5E1] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              <span class="text-[#64748B]" data-i18n="home.trad4">Often behind a paywall</span>
            </li>
          </ul>
        </div>

        <div class="bg-[#EEF2FF] rounded-2xl p-8 border border-[#C7D2FE]">
          <h3 class="text-sm font-bold text-[#4F46E5] uppercase tracking-wider mb-6" data-i18n="home.senaraLabel">Senara</h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-[#4F46E5] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span class="text-[#334155]" data-i18n="home.sen1">Experience the lesson through a character's eyes</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-[#4F46E5] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span class="text-[#334155]" data-i18n="home.sen2">You make decisions — the story responds</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-[#4F46E5] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span class="text-[#334155]" data-i18n="home.sen3">Topics grounded in real-life situations</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-[#4F46E5] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span class="text-[#334155]" data-i18n="home.sen4">Free. No account needed. No catch.</span>
            </li>
          </ul>
        </div>
      </div>

      <div class="testimonials-grid" id="testimonialContent"></div>
    </div>
  </section>

  <section class="py-24 md:py-32 px-4 bg-gradient-to-b from-[#EEF2FF] to-[#F8FAFC]">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-[#0F172A] mb-4" data-i18n="home.climaxTitle">
        Your first story is waiting.
      </h2>
      <p class="text-lg text-[#64748B] mb-8" data-i18n="home.climaxDesc">
        No sign-up. No payment. Just pick a story and start.
      </p>
      <a href="/collection" class="btn-primary inline-block px-10 py-4 text-lg" data-umami-event="Home climax CTA" data-i18n="home.climaxCta">
        Browse Stories
      </a>
    </div>
  </section>

  <Fragment slot="scripts">
    <script>
      import { initHomePage } from '../scripts/home-page';
      import { initVNDemo } from '../scripts/vn-demo';
      document.addEventListener('DOMContentLoaded', () => {
        initHomePage();
        initVNDemo();
      });
    </script>
  </Fragment>
</BaseLayout>
