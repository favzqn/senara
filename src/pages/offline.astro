---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Offline | Senara"
  description="You are currently offline. Some pages may not be available."
  canonical="https://senara.id/offline"
  pageName="offline"
  bodyDataPage="offline"
>
  <main class="min-h-screen flex items-center justify-center px-4">
    <div class="text-center max-w-md">
      <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#4F46E5" stroke-width="1.5" class="mx-auto mb-6"><path d="M1 1l22 22"/><path d="M16.72 11.06A10.94 10.94 0 0119 12.55"/><path d="M5 12.55a10.94 10.94 0 015.17-2.39"/><path d="M10.71 5.05A16 16 0 0122.56 9"/><path d="M1.42 9a15.91 15.91 0 014.7-2.88"/><path d="M8.53 16.11a6 6 0 016.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>
      <h1 class="text-2xl font-bold text-[#0F172A] mb-3" data-i18n="offline.title">You're Offline</h1>
      <p class="text-[#64748B] mb-6" data-i18n="offline.message">It looks like you've lost your internet connection. Some pages may not be available offline yet.</p>
      <button onclick="location.reload()" class="clay-btn" data-i18n="offline.tryAgain">Try Again</button>
    </div>
  </main>
</BaseLayout>
