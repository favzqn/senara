        <input type="text" id="faqSearch" class="faq-search" placeholder="Search questions..." data-i18n-placeholder="faq.searchPlaceholder" aria-label="Search frequently asked questions">
        <span class="faq-search-kbd"><span class="kbd">/</span></span>
      </div>
    </div>
  </header>

