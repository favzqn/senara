---
const year = new Date().getFullYear();
---

<footer class="senara-footer" role="contentinfo">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="Senara home">Senara</a>
        <p class="footer-tagline" data-i18n="footer.tagline">Interactive story platform for learning important topics through meaningful experiences.</p>
        <div class="footer-social">
          <a href="https://instagram.com/idsenara" target="_blank" rel="noopener" class="footer-social-link" data-umami-event="Footer Instagram" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <a href="https://trakteer.id/senara.id" target="_blank" rel="noopener" class="footer-social-link" data-umami-event="Footer Trakteer" aria-label="Trakteer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </a>
        </div>
      </div>

      <div class="footer-column">
        <h4 data-i18n="footer.explore">Explore</h4>
        <a href="/" data-umami-event="Footer Home" data-i18n="footer.home">Home</a>
        <a href="/collection" data-umami-event="Footer Collection" data-i18n="footer.storyCollection">Story Collection</a>
        <a href="/about" data-umami-event="Footer About" data-i18n="footer.aboutUs">About Us</a>
        <a href="/about?tab=team" data-umami-event="Footer Team" data-i18n="footer.team">Senara Team</a>
      </div>

      <div class="footer-column">
        <h4 data-i18n="footer.support">Support</h4>
        <a href="/faq" data-umami-event="Footer FAQ" data-i18n="footer.faq">FAQ</a>
        <a href="/safety" data-umami-event="Footer Safety" data-i18n="footer.safety">Safety</a>
        <a href="/contact" data-umami-event="Footer Contact" data-i18n="footer.contactUs">Contact Us</a>
        <a href="/about?tab=contribute" data-umami-event="Footer Contribute" data-i18n="footer.contribute">Contribute</a>
        <a href="/for-organizations" data-umami-event="Footer Orgs" data-i18n="footer.forOrganizations">For Organizations</a>
        <a href="/donate" data-umami-event="Footer Donate" data-i18n="footer.supportSenara">Support Senara</a>
      </div>

      <div class="footer-column">
        <h4 data-i18n="footer.privacy">Privacy</h4>
        <a href="/privacy" data-umami-event="Footer Privacy" data-i18n="footer.privacy">Privacy</a>
        <a href="/terms" data-umami-event="Footer Terms" data-i18n="footer.terms">Terms</a>
        <a href="/accessibility" data-umami-event="Footer Accessibility" data-i18n="footer.accessibility">Accessibility</a>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-bottom-left">
        <span class="footer-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span data-i18n="footer.nonprofit">Nonprofit</span>
        </span>
        <span class="footer-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          <span data-i18n="footer.freeForAll">Free for everyone</span>
        </span>
      </div>
      <p class="footer-copyright">&copy; {year} <span data-i18n="footer.copyright">Senara. Made with heart in Indonesia.</span></p>
    </div>
  </div>
</footer>
