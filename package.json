  "bugs": {
    "url": "https://github.com/favzqn/senara/issues"
  },
  "homepage": "https://github.com/favzqn/senara#readme",
  "devDependencies": {
    "playwright": "^1.61.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^6.4.6",
    "hyperframes": "^0.7.61",
    "serve": "^14.2.6"
  }
