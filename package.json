{
  "name": "senara",
  "version": "1.0.0",
  "description": "",
  "main": "bump-version.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "fetch:videos": "npx tsx src/scripts/fetch-videos.ts",
    "build": "npm run fetch:videos && npm run build:css && astro build",
    "build:css": "tailwindcss -i style/tailwind-input.css -o public/style/tailwind.min.css --minify",
    "watch:css": "tailwindcss -i style/tailwind-input.css -o public/style/tailwind.min.css --watch",
    "preview": "astro preview",
    "serve": "npx serve dist -l 8080",
    "bump": "node bump-version.js",
    "test": "npm run build",
    "test:unit": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/favzqn/senara.git"
  },
